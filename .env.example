# تنظیمات صرافی - Exchange Settings
API_KEY=your_api_key_here
API_SECRET=your_secret_key_here
API_PASSWORD=your_password_here

# تنظیمات اعلان تلگرام (اختیاری) - Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# یادداشت:
# 1. این فایل را به .env تغییر نام دهید
# 2. مقادیر واقعی API را جایگزین کنید
# 3. فایل .env را به git اضافه نکنید (در .gitignore قرار دارد)
